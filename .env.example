APP_NAME=Elenora-Website
ACCESS_TOKEN_SECRET_KEY=your_access_token_secret_key_super_secure_here
REFRESH_TOKEN_SECRET_KEY=your_refresh_token_secret_key_super_secure_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── DATABASE CONFIGURATION (POSTGRESQL) ──
# On Render / Supabase / Neon / AWS RDS, paste your cloud PostgreSQL connection string:
# DATABASE_URL=postgres://user:password@dpg-xxxxx.oregon-postgres.render.com/elenora_db
# For Local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/elenora_db
DATABASE_URL=sqlite+aiosqlite:///./asset_tracking.db

# ── POSTGRESQL POOL TUNING ──
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# ── ADMINISTRATIVE CONCIERGE ──
ADMIN_EMAIL=admin@elanora-luxury.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_FULL_NAME=Elenora Concierge
