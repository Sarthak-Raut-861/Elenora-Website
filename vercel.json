{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend-app/dist",
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "https://elenora-website.onrender.com/uploads/$1"
    },
    {
      "source": "/((?!uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
