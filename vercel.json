{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend-app/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|uploads/|health|docs|openapi.json).*)",
      "destination": "/index.html"
    }
  ]
}
